#!/usr/bin/env python3

import argparse
import requests
import json
import time
import os
import sys

BASE_URL = os.environ.get('TAPREPO_URL', 'http://127.0.0.1:8000')
USERNAME = os.environ.get('TAPREPO_USER', 'admin')
PASSWORD = os.environ.get('TAPREPO_PASS', '#')

def get_access_token():
    try:
        response = requests.post(f'{BASE_URL}/api/token/', json={
            'username': USERNAME,
            'password': PASSWORD
        })
        if response.status_code == 200:
            return response.json().get('access')
        else:
            print(f"Failed to get token: {response.status_code} {response.text}", file=sys.stderr)
            sys.exit(1)
    except requests.exceptions.RequestException as e:
        print(f"Connection error: {e}", file=sys.stderr)
        sys.exit(1)

def get_headers():
    token = get_access_token()
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json"
    }

def file_manager(file_name):
    try:
        with open(file_name, 'r') as file:
            lines = file.readlines()
    except FileNotFoundError:
        print("file not found.")
        return []

    parameters = []
    for line in lines:
        stripped = line.strip()
        if len(stripped) > 0:
            parameters.append({"name": stripped})
    
    return parameters

def get_parameters(site, top, type_name):
    params = {}
    if site:
        params['site'] = site
    if top:
        params['top'] = top
    if type_name:
        params['type'] = type_name
    
    response = requests.get(f'{BASE_URL}/parameters/', params=params, headers=get_headers())
    return response.json()

def add_parameter(name, type_name=None, site=None):
    data = {'name': name}
    if type_name:
        data['type'] = type_name
    if site:
        data['site'] = site
    
    response = requests.post(f'{BASE_URL}/parameters/', json=data, headers=get_headers())
    return response.json()

def add_parameters(params_list, type_name=None, site=None):
    print(len(params_list), " param.")
    if len(params_list) > 200:
        for i in range(0, len(params_list), 200):
            chunk = params_list[i:i + 200]
            data = {'params': chunk}
            if type_name:
                data['type'] = type_name
            if site:
                data['site'] = site
            
            max_retries = 3
            for attempt in range(max_retries):
                try:
                    response = requests.post(f'{BASE_URL}/parameters/', json=data, headers=get_headers())
                    break
                except requests.exceptions.RequestException as e:
                    print(f"Attempt {attempt+1} failed: {e}")
                    time.sleep(1)
            else:
                print("Failed after retries")
                continue
            
            print(f"{min(i+len(chunk), len(params_list))} parameter saved.", response.json())
    else:
        data = {'params': params_list}
        if type_name:
            data['type'] = type_name
        if site:
            data['site'] = site
        
        response = requests.post(f'{BASE_URL}/parameters/', json=data, headers=get_headers())
        print(len(params_list), " parameter saved.")
        return response.json()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='Interact with parameters API.')
    parser.add_argument('--get', action='store_true', help='Get parameters')
    parser.add_argument('--all', action='store_true', help='Get all parameters')
    parser.add_argument('--top', type=int, help='Get top parameters')
    parser.add_argument('--type', type=str, help='Get/Set parameters type')
    parser.add_argument('--add', action='store_true', help='Add a new parameter')
    parser.add_argument('--name', type=str, help='Name of the parameter to add')
    parser.add_argument('--site', type=str, help='Site of the parameter is used')
    parser.add_argument('-r', '--read', type=str, help='Path to the file containing parameters')

    args = parser.parse_args()

    if args.get:
        if args.all:
            for parameter in get_parameters(None, None, None):
                print(parameter)
        else:
            top = args.top if args.top else None
            type_name = args.type if args.type else None
            site = args.site if args.site else None
            for parameter in get_parameters(site, top, type_name):
                print(parameter)
    elif args.add:
        type_name = args.type if args.type else None
        site = args.site if args.site else None
        
        if args.read:
            params_list = file_manager(args.read)
            if params_list:
                add_parameters(params_list, type_name, site)
            else:
                print("No parameters read from file.")
        elif args.name:
            print(add_parameter(args.name, type_name, site))
        else:
            print("You must provide --name or --read when adding a parameter.")