def add_parameter(name, type=None, site=None):

    data = {'name': name, 'type': type, 'site': site}
    data = {k: v for k, v in data.items() if v is not None}
    response = requests.post(f'{base_url}/parameters/', data=json.dumps(data), headers=Headers)
    return response.json()

def add_parameters(params, type=None, site=None):
    params = json.loads(params)
    print(len(params), " param.")
    if len(params) > 200:
        for i in range(0, len(params), 200):
            chunk = params[i:i + 200]
            param = json.dumps(chunk, indent=4)
            data = {'params': json.loads(param), 'type': type, 'site': site}
            data = {k: v for k, v in data.items() if v is not None}
            while True:    
                try:
                    response = requests.post(f'{base_url}/parameters/', data=json.dumps(data), headers=Headers)
                    break
                except:
                    print("error")
                    time.sleep(1)
            print(len(json.loads(param))+i, " parameter saved.", response.json())
            
    else:
        # print(json.dumps(params, indent=4))
        data = {'params': params, 'type': type, 'site': site}
        data = {k: v for k, v in data.items() if v is not None}
        response = requests.post(f'{base_url}/parameters/', data=json.dumps(data), headers=Headers)
        print(len(params), " parameter saved.")
        return response.json()

